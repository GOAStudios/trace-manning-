{
  // Cloudflare settings for the website.
  "name": "trace-manning-construction",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Change these once the domain is bought and verified in Resend
    "TO_EMAIL": "owner@example.com",
    "FROM_EMAIL": "quotes@example.com",
    // Text alerts (optional): fill in after setting up Twilio
    "ALERT_PHONE": "+18507163740",
    "TWILIO_FROM": ""
  }
  // Secrets (RESEND_API_KEY, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, SHEET_WEBHOOK_URL, SHEET_SECRET)
  // are added in Cloudflare (Settings > Variables and Secrets), never here.
}
