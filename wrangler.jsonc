{
  // Cloudflare settings for the website.
  "name": "contractor-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Change these once the domain is bought and verified in Resend
    "TO_EMAIL": "owner@example.com",
    "FROM_EMAIL": "quotes@example.com"
  }
  // RESEND_API_KEY is a secret: add it in Cloudflare (Settings > Variables and Secrets), never here.
}
